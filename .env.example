# Copie este arquivo para .env e preencha os valores

# --- OBRIGATÓRIO ---
SECRET_KEY=coloque-uma-chave-secreta-longa-e-aleatoria-aqui

# --- AMBIENTE ---
# True para desenvolvimento, False para produção
DEBUG=True

# Hosts permitidos (separados por vírgula). Em dev pode deixar vazio.
# Ex: ALLOWED_HOSTS=meusite.railway.app,www.meusite.com
ALLOWED_HOSTS=

# --- BANCO DE DADOS (produção) ---
# Deixe vazio para usar SQLite em desenvolvimento
# Ex: DATABASE_URL=postgresql://user:senha@host:5432/nome_db
DATABASE_URL=

# --- MÍDIA / STORAGE (produção com Cloudflare R2 ou AWS S3) ---
# Deixe USE_S3=False para salvar localmente em desenvolvimento
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# URL do endpoint R2: https://<account_id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
# Domínio público do bucket (opcional)
AWS_S3_CUSTOM_DOMAIN=
